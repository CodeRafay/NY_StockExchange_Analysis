mean_price <- mean(data$close, na.rm = TRUE)
median_price <- median(data$close, na.rm = TRUE)
sd_price <- sd(data$close, na.rm = TRUE)
min_price <- min(data$close, na.rm = TRUE)
max_price <- max(data$close, na.rm = TRUE)
# Calculate 95% Confidence Interval for the mean of the closing prices
ci <- t.test(data$close)$conf.int
conf_interval_text <- paste("<b>95% Confidence Interval for Mean:</b> ",
round(ci[1], 2), " to ", round(ci[2], 2), "<br>"
)
result_text <- paste(
"<h4>Closing Price Statistics</h4>",
"<b>Mean:</b> ", round(mean_price, 2), "<br>",
"<b>Median:</b> ", round(median_price, 2), "<br>",
"<b>Standard Deviation:</b> ", round(sd_price, 2), "<br>",
"<b>Min:</b> ", round(min_price, 2), "<br>",
"<b>Max:</b> ", round(max_price, 2), "<br>",
conf_interval_text
)
HTML(result_text)
})
# Output for statistical histogram
output$statistical_hist <- renderPlotly({
data <- plotData()
plot_ly(data = data, x = ~close, type = 'histogram', nbinsx = 30) %>%
layout(title = "Histogram of Closing Prices",
xaxis = list(title = "Closing Price"),
yaxis = list(title = "Frequency"))
})
# Output for boxplot
output$box_stat <- renderPlotly({
data <- plotData()
plot_ly(data = data, y = ~close, type = 'box') %>%
layout(title = "Boxplot of Closing Prices",
yaxis = list(title = "Closing Price"))
})
# Output for candlestick chart
output$candlestick <- renderPlotly({
data <- plotData()  # Get the filtered data based on the selected company and date range
# Ensure that the date column is in Date format (if it is not already)
data$date <- as.Date(data$date)  # Convert to Date type if it's not already in this format
# Prepare the data for the candlestick chart
fig <- plot_ly(data = data, x = ~date, type = "candlestick",
open = ~open, close = ~close, high = ~high, low = ~low) %>%
layout(
title = list(
text = "Candlestick Chart for Stock",
x = 0.5,   # This centers the title
xanchor = "center",   # This aligns the title to the center horizontally
y = 1.1,   # This moves the title slightly upwards
yanchor = "top"
),
xaxis = list(
title = "Date",
type = "date"  # Ensure Plotly interprets the x-axis as a date
),
yaxis = list(title = "Price"),
margin = list(t = 40),   # Adjust the top margin if needed to create space for the title
dragmode = "zoom"  # Enable zoom mode by default
)
fig
})
# Regression Prediction output
output$prediction <- renderText({
req(input$x1, input$x2, input$x3, input$x4, input$x5)
# Prepare input data for regression model
regression_data <- data.frame(
day = 1:5,
closing_price = c(input$x1, input$x2, input$x3, input$x4, input$x5)
)
# Fit linear regression model
model <- lm(closing_price ~ day, data = regression_data)
# Predict closing price for day 6
prediction <- predict(model, newdata = data.frame(day = 6))
# Return the predicted value
paste("Predicted Closing Price for Day 6: $", round(prediction, 2))
})
# Output for regression model assumptions
output$model_result <- renderPlot({
req(input$x1, input$x2, input$x3, input$x4, input$x5)
regression_data <- data.frame(
day = 1:5,
closing_price = c(input$x1, input$x2, input$x3, input$x4, input$x5)
)
# Fit linear regression model
model <- lm(closing_price ~ day, data = regression_data)
# Plot the residuals
plot(model$residuals, main = "Residuals of the Regression Model",
ylab = "Residuals", xlab = "Days", pch = 19, col = "blue")
abline(h = 0, col = "red")
})
# Output for regression prediction check
output$prediction_check <- renderPlot({
req(input$x1, input$x2, input$x3, input$x4, input$x5)
regression_data <- data.frame(
day = 1:5,
closing_price = c(input$x1, input$x2, input$x3, input$x4, input$x5)
)
# Fit linear regression model
model <- lm(closing_price ~ day, data = regression_data)
# Plot the data and regression line
plot(regression_data$day, regression_data$closing_price,
main = "Closing Price vs. Day", xlab = "Day", ylab = "Closing Price",
pch = 19, col = "blue")
abline(model, col = "red")
})
}
# Run the Shiny app
shinyApp(ui, server)
# Load required libraries
load("prices.RData")  # Assuming prices.RData contains your stock price data
library(shiny)
library(shinydashboard)
library(shinydashboardPlus)
library(dplyr)
library(ggplot2)
library(lubridate)
library(plotly)
library(tidyverse)
library(TTR)
library(performance)
# Define the UI layout
ui <- dashboardPage(
# Header section
header = dashboardHeader(
leftUi = tagList(
h4("New York Stock Exchange")
)
),
# Sidebar section
sidebar = dashboardSidebar(
sidebarMenu(
menuItem("Statistical Summary", tabName = "statistics", icon = icon("dashboard")),
menuItem("Regression Summary", tabName = "regression", icon = icon("dashboard"))
)
),
# Body section
body = dashboardBody(
tabItems(
tabItem(tabName = "statistics",  # Statistical Summary tab
fluidRow(
column(width = 4,
box(width = 12,
selectInput("sel_companies", label = "Symbols", choices = NULL),
dateRangeInput("daterange", "Date range:", format = "dd/mm/yy", separator = " - "),
h3("Descriptive Statistical Measure"),
htmlOutput("statistical_measure"),
plotlyOutput("statistical_hist")
)
),
column(width = 8,
box(width = 12,
plotlyOutput("candlestick"),
HTML("<br>"),
fluidRow(
column(width = 6, plotlyOutput("performance_stat")),
column(width = 6, plotlyOutput("box_stat"))
)
)
)
)
),
tabItem(tabName = "regression",  # Regression Summary tab
fluidRow(
column(width = 4,
box(width = 12,
selectInput("sel_companies_reg", label = "Symbols", choices = NULL),
HTML("<br>"),
numericInput("x1", "Day 1 Closing Price", value = 0),
numericInput("x2", "Day 2 Closing Price", value = 0),
numericInput("x3", "Day 3 Closing Price", value = 0),
numericInput("x4", "Day 4 Closing Price", value = 0),
numericInput("x5", "Day 5 Closing Price", value = 0),
textOutput("prediction"),
HTML("<br>"),
actionButton("printButton", "Predict")
)
),
box(width = 8,
h2("Model Assumptions"),
plotOutput("model_result"),
plotOutput("prediction_check")
)
)
)
)
),
title = "DashboardPage"
)
# Define the server logic
server <- function(input, output, session) {
# Reactive value to store model result
model_result <- reactiveVal(NULL)
# Update selectInput choices based on data
observe({
updateSelectInput(session, "sel_companies", choices = sort(unique(prices$symbol)))
updateSelectInput(session, "sel_companies_reg", choices = sort(unique(prices$symbol)))
})
# Reactive function to filter data based on selected company
company <- reactive({
req(input$sel_companies)
prices[prices$symbol == input$sel_companies, ]
})
# Update date range based on selected company
observe({
min_date <- min(company()$date, na.rm = TRUE)
max_date <- max(company()$date, na.rm = TRUE)
updateDateRangeInput(session, "daterange", start = min_date, end = max_date, min = min_date, max = max_date)
})
# Reactive function to filter data based on selection and date range
plotData <- reactive({
req(input$sel_companies)
req(input$daterange)
date_filtered <- company()$date >= input$daterange[1] & company()$date <= input$daterange[2]
company() %>% filter(date_filtered)
})
# Output for descriptive statistical measures
output$statistical_measure <- renderText({
data <- plotData()
mean_price <- mean(data$close, na.rm = TRUE)
median_price <- median(data$close, na.rm = TRUE)
sd_price <- sd(data$close, na.rm = TRUE)
min_price <- min(data$close, na.rm = TRUE)
max_price <- max(data$close, na.rm = TRUE)
result_text <- paste(
"<h4>Closing Price Statistics</h4>",
