"<b>Median:</b> ", round(median_price, 2), "<br>",
"<b>Standard Deviation:</b> ", round(sd_price, 2), "<br>",
"<b>Min:</b> ", round(min_price, 2), "<br>",
"<b>Max:</b> ", round(max_price, 2), "<br>"
)
HTML(result_text)
})
# Output for statistical histogram
output$statistical_hist <- renderPlotly({
data <- plotData()
plot_ly(data = data, x = ~close, type = 'histogram', nbinsx = 30) %>%
layout(title = "Histogram of Closing Prices",
